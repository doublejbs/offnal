# 오프날 환경 변수 예시. `.env.local`로 복사해 사용한다.
# 한도·TTL·가격 등 숫자 값은 모두 초기 제안값이며 출시 전 조정할 수 있다.

# 실행 환경: development | test | preview | production
OFFNAL_ENV=development
# 실행 모드: live(실제 제공자) | demo(가상 인식·테스트 결제·데모 로그인). production에서 demo는 기동 차단
# 키 없는 테스트 배포: OFFNAL_ENV=preview + APP_MODE=live + VISION_PROVIDER=mock/PAYMENT_PROVIDER=mock (화면에 테스트 환경 배너, production에선 차단)
APP_MODE=demo
# 앱 공개 URL. CSRF Origin 검사·공유 링크·로그인 콜백(${APP_URL}/auth/callback)에 사용
APP_URL=https://localhost:3000
# 세션·공유 토큰 암호화 키 파생용 비밀값 (32바이트 이상 임의 문자열)
APP_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# ─── Supabase ───────────────────────────────────────────────────────────────
# DB·인증(카카오 로그인)·원본 저장소 모두 Supabase를 쓴다. 로컬 개발도 개발용 클라우드 프로젝트에 연결한다.
# 키 없이 띄우는 데모(APP_MODE=demo)와 자동 테스트만 PGlite·로컬 파일·데모 로그인으로 동작한다.

# 앱 서버용 Postgres 접속 문자열 (Supabase 대시보드 상단 Connect → Connection string → Transaction pooler, 포트 6543)
# 예: postgresql://postgres.<project-ref>:<DB 비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 비우면 PGlite(임베디드 Postgres) — OFFNAL_ENV=test 또는 development + APP_MODE=demo 에서만 허용
# *.supabase.com/co 호스트는 자동으로 TLS 연결한다
DATABASE_URL=
# `pnpm db:migrate` 전용 접속 문자열 (Connect → Session pooler 포트 5432, 또는 IPv6가 되면 Direct connection)
# 비우면 DATABASE_URL 사용. 마이그레이션(DDL)은 트랜잭션 풀러 대신 세션 풀러/직접 연결을 권장
DATABASE_MIGRATION_URL=
# (선택) Supabase DB 서버 인증서 검증용 루트 CA (Project Settings → Database → SSL Configuration → Download certificate)
# PEM 내용을 한 줄로 넣고 줄바꿈은 \n 으로 쓴다. 비우면 저장소에 포함된 Supabase Root 2021 CA로 검증한다
DATABASE_SSL_ROOT_CERT=
# PGlite 데이터 디렉터리. `memory`면 메모리 DB (기본 .data/pglite)
PGLITE_DIR=.data/pglite

# Supabase 프로젝트 URL (Project Settings → Data API → Project URL, 예: https://<project-ref>.supabase.co). 공개 값
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 공개 키 (Project Settings → API Keys → Publishable key `sb_publishable_...`). 공개 값
# 예전 프로젝트는 Legacy API Keys의 anon 키를 NEXT_PUBLIC_SUPABASE_ANON_KEY 에 넣어도 된다
# 모든 테이블이 RLS + 정책 없음이라 이 키로는 어떤 데이터도 읽거나 쓸 수 없다. secret/service_role 키는 쓰지 않는다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 원본 저장소: local(개발용 로컬 파일) | s3(Supabase Storage 비공개 버킷, S3 호환)
# 비우면 demo·test는 local, 그 밖의 live는 s3
STORAGE_DRIVER=local
# 로컬 저장 디렉터리
LOCAL_STORAGE_DIR=.data/storage
# Supabase Storage S3 엔드포인트 (Storage → S3 Configuration → Endpoint)
# 형식: https://<project-ref>.storage.supabase.co/storage/v1/s3 (path-style 주소는 코드에서 항상 켠다)
S3_ENDPOINT=
# 프로젝트 리전 (Storage → S3 Configuration → Region, 서울이면 ap-northeast-2)
S3_REGION=ap-northeast-2
# 비공개 버킷 이름 (Storage → New bucket, Public bucket 끔, 정책 추가하지 않음)
S3_BUCKET=
# S3 접근 키 ID (Storage → S3 Configuration → Access keys → New access key). RLS를 우회하므로 서버 전용
S3_ACCESS_KEY_ID=
# S3 비밀 접근 키 (발급 시 한 번만 보인다)
S3_SECRET_ACCESS_KEY=

# 사용할 로그인 제공자 목록(쉼표 구분)
# kakao: Supabase Auth 카카오 로그인 (NEXT_PUBLIC_SUPABASE_URL·공개 키 필요, 없으면 로그인 시 login=failed)
# dev: 데모 전용 즉시 로그인. APP_MODE=demo면 항상 추가되고 live에서는 무시, production에서는 기동 차단
# 기본값: live → kakao, demo → dev. 데모에서 카카오도 시험하려면 kakao,dev
AUTH_PROVIDERS=dev

# 근무표 인식 제공자: anthropic | gemini | mock(가상 fixture, development·preview에서만 허용)
VISION_PROVIDER=mock
# Anthropic API 키
ANTHROPIC_API_KEY=
# Google AI Studio(Gemini API) 키 (서버 전용, 로그에 남기지 않음)
GEMINI_API_KEY=
# Gemini 키의 과금 티어: free | paid (기본 free)
# 무료 티어는 입력(사진·프롬프트)이 Google 제품 개선에 쓰일 수 있어 실제 사용자 사진에 쓰지 않는다.
# production에서 VISION_PROVIDER=gemini는 GEMINI_TIER=paid 없이는 기동이 차단된다.
GEMINI_TIER=free
# 인식 모델 ID (비우면 anthropic → claude-opus-5-5, gemini → gemini-3.7-flash)
VISION_MODEL=
# 인식 effort (low | medium | high | xhigh | max) — Anthropic에만 적용, Gemini는 모델 기본 thinking
VISION_EFFORT=medium
# 인식 요청 타임아웃(ms) — 초기 제안값
VISION_TIMEOUT_MS=240000
# 2차 추출 입력 방식: baseline(원본) | warp(원근 보정) | warp-strip(원근 보정 + 행 띠, 기본)
VISION_PIPELINE=warp-strip
# mock 인식 인위적 지연(ms) — 테스트에서는 0
MOCK_VISION_DELAY_MS=1200
# AI 없는 OCR 그림자 모드(docs/Spec.md §22): off(기본) | shadow — 데모 모드·테스트에서는 항상 off
# shadow면 2차 인식 응답 뒤 OCR을 돌려 AI 결과와 비교한 수치만 ocr_shadow_runs에 저장한다(사용자 결과는 그대로)
OCR_MODE=off
# 그림자 실행 비율(0~1, 기본 0.3). 빈 값은 기본값으로 본다(0으로 끄려면 0을 적는다)
OCR_SHADOW_SAMPLE_RATE=0.3
# OCR 한 번의 시간 제한(ms, 최대 120000). 실행 때 2차 인식 함수의 남은 시간으로 다시 줄인다
OCR_TIMEOUT_MS=60000

# 지표 이벤트 저장(docs/Spec.md §23): off | console | db
# 기본: development console, test off, preview·production db. 데모 모드는 db 대신 console(저장 안 함)
# 이벤트에는 가명 키(APP_SECRET HMAC)와 숫자·불리언·고정 enum 값만 남는다(이름·근무·토큰 없음)
# ANALYTICS_SINK=console

# 결제 모드: paid(기본값, 무료 두 달 후 월 결제) | beta_free(베타 무료 운영 — 결제·가격 문구를 숨기고 모든 달을 무료로 등록)
# production에서 paid + toss인데 토스 키가 없으면 기동 차단. 토스 키 없는 production은 beta_free로만 뜬다
BILLING_MODE=paid
# 결제 제공자: toss | mock(테스트 결제 버튼, development·preview에서만 허용)
PAYMENT_PROVIDER=mock
# 토스페이먼츠 클라이언트 키 (test_ 로 시작하면 테스트 모드)
TOSS_CLIENT_KEY=
# 토스페이먼츠 시크릿 키 (서버 전용, 로그에 남기지 않음)
# 토스 개발자센터 웹훅 URL: ${APP_URL}/api/payments/webhook (이벤트: PAYMENT_STATUS_CHANGED)
TOSS_SECRET_KEY=

# 월 이용권 가격(원) — 초기 제안값
PRICE_KRW=990
# 계정별 무료 월 수 — 초기 제안값
FREE_MONTH_LIMIT=2

# 업로드 최대 크기(바이트, 기본 4MB) — 초기 제안값.
# Vercel 함수 요청 본문 한도(약 4.5MB) 때문에 4MB로 두고, 화면에서 업로드 전에 사진을 축소한다
UPLOAD_MAX_BYTES=4194304
# 업로드 최대 픽셀 수(기본 40MP) — 초기 제안값
UPLOAD_MAX_PIXELS=40000000
# 익명 세션당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_ANON_DAILY=5
# IP 해시당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_IP_DAILY=20
# 로그인 사용자당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_USER_DAILY=20
# 사용자당 월간 개인 추출 한도 — 초기 제안값
EXTRACT_LIMIT_USER_MONTHLY=30
# 공유 링크 조회 IP당 일일 한도(토큰 추측 완화) — 초기 제안값
RATE_LIMIT_SHARED_IP_DAILY=300
# 결제 웹훅 IP당 일일 한도(제공자 IP 몇 개에서 모두 오므로 넉넉하게) — 초기 제안값
RATE_LIMIT_WEBHOOK_IP_DAILY=5000
# 원본·임시 인식 작업 보관 시간(시간) — 초기 제안값
SOURCE_TTL_HOURS=24
# 개인 초안 보관 기간(일) — 초기 제안값
DRAFT_TTL_DAYS=30

# 정리 cron 호출 인증용 비밀값 (Authorization: Bearer ...). Vercel Cron은 CRON_SECRET이 설정되면 이 헤더를 자동으로 붙인다.
# 비우면 /api/cron/cleanup 은 503. production에서는 32자 이상이어야 하며 아래 예시 값이면 기동 차단
CRON_SECRET=change-me-cron-secret
