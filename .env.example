# 오프날 환경 변수 예시. `.env.local`로 복사해 사용한다.
# 한도·TTL·가격 등 숫자 값은 모두 초기 제안값이며 출시 전 조정할 수 있다.

# 실행 환경: development | test | preview | production
OFFNAL_ENV=development
# 실행 모드: live(실제 제공자) | demo(가상 인식·테스트 결제·데모 로그인). production에서 demo는 기동 차단
APP_MODE=demo
# 앱 공개 URL. CSRF Origin 검사·공유 링크·OAuth 콜백에 사용
APP_URL=https://localhost:3000
# 세션·공유 토큰 암호화 키 파생용 비밀값 (32바이트 이상 임의 문자열)
APP_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# 운영 Postgres 접속 문자열. 비우면 PGlite(임베디드 Postgres) 사용
DATABASE_URL=
# PGlite 데이터 디렉터리. `memory`면 메모리 DB (기본 .data/pglite)
PGLITE_DIR=.data/pglite

# 원본 저장소: local(개발용 로컬 파일) | s3(S3 호환 비공개 버킷)
STORAGE_DRIVER=local
# 로컬 저장 디렉터리
LOCAL_STORAGE_DIR=.data/storage
# S3 호환 엔드포인트 (예: Supabase Storage S3 엔드포인트)
S3_ENDPOINT=
# S3 리전
S3_REGION=ap-northeast-2
# 비공개 버킷 이름
S3_BUCKET=
# S3 접근 키 ID
S3_ACCESS_KEY_ID=
# S3 비밀 접근 키
S3_SECRET_ACCESS_KEY=

# 사용할 로그인 제공자 목록(쉼표 구분): google, dev(데모 전용 즉시 로그인)
AUTH_PROVIDERS=dev
# Google OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
# Google OAuth 클라이언트 비밀값
GOOGLE_CLIENT_SECRET=

# 근무표 인식 제공자: anthropic | mock(가상 fixture)
VISION_PROVIDER=mock
# Anthropic API 키
ANTHROPIC_API_KEY=
# 인식 모델 ID
VISION_MODEL=claude-opus-5-5
# 인식 effort (low | medium | high)
VISION_EFFORT=medium
# 인식 요청 타임아웃(ms) — 초기 제안값
VISION_TIMEOUT_MS=240000
# mock 인식 인위적 지연(ms) — 테스트에서는 0
MOCK_VISION_DELAY_MS=1200

# 결제 제공자: toss | mock(테스트 결제 버튼)
PAYMENT_PROVIDER=mock
# 토스페이먼츠 클라이언트 키 (test_ 로 시작하면 테스트 모드)
TOSS_CLIENT_KEY=
# 토스페이먼츠 시크릿 키
TOSS_SECRET_KEY=

# 월 이용권 가격(원) — 초기 제안값
PRICE_KRW=1900
# 계정별 무료 월 수 — 초기 제안값
FREE_MONTH_LIMIT=2

# 업로드 최대 크기(바이트, 기본 10MB) — 초기 제안값
UPLOAD_MAX_BYTES=10485760
# 업로드 최대 픽셀 수(기본 40MP) — 초기 제안값
UPLOAD_MAX_PIXELS=40000000
# 익명 세션당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_ANON_DAILY=5
# IP 해시당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_IP_DAILY=20
# 로그인 사용자당 일일 업로드 한도 — 초기 제안값
RATE_LIMIT_USER_DAILY=20
# 사용자당 월간 개인 추출 한도 — 초기 제안값
EXTRACT_LIMIT_USER_MONTHLY=30
# 원본·임시 인식 작업 보관 시간(시간) — 초기 제안값
SOURCE_TTL_HOURS=24
# 개인 초안 보관 기간(일) — 초기 제안값
DRAFT_TTL_DAYS=30

# 정리 cron 호출 인증용 비밀값 (Authorization: Bearer ...)
CRON_SECRET=change-me-cron-secret
